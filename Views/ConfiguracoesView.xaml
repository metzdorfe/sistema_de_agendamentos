<UserControl x:Class="EspacoFestas.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EspacoFestas.Controls">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Configurações" Style="{StaticResource TextoTituloTela}"/>
            <TextBlock Text="Ajuste as preferências do sistema." Style="{StaticResource TextoSubtitulo}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GrupoAbas}" Margin="0,24,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AbaParametros" Style="{StaticResource Aba}" Content="Parâmetros" GroupName="AbasConfig" Click="Aba_Click"/>
                <RadioButton x:Name="AbaEspecies" Style="{StaticResource Aba}" Content="Espécies de pagamento" GroupName="AbasConfig" Click="Aba_Click"/>
                <RadioButton x:Name="AbaEmpresaBotao" Style="{StaticResource Aba}" Content="Empresa" GroupName="AbasConfig" Click="Aba_Click"/>
                <RadioButton x:Name="AbaAparencia" Style="{StaticResource Aba}" Content="Aparência" GroupName="AbasConfig" Click="Aba_Click"/>
                <RadioButton x:Name="AbaWhatsapp" Style="{StaticResource Aba}" Content="WhatsApp" GroupName="AbasConfig" Click="Aba_Click"/>
                <RadioButton x:Name="AbaSobre" Style="{StaticResource Aba}" Content="Sobre" GroupName="AbasConfig" Click="Aba_Click"/>
            </StackPanel>
        </Border>

        <!-- ============================== Parâmetros ============================== -->
        <ScrollViewer x:Name="PainelParametros" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Cartao}" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Parâmetros de negócio" Style="{StaticResource TextoTituloSecao}" Margin="0,0,0,20"/>

                    <CheckBox x:Name="ChkBloqueio" Style="{StaticResource Interruptor}" Content="Um agendamento por dia"/>
                    <TextBlock Style="{StaticResource TextoAuxiliar}" Margin="52,4,0,24"
                               Text="Com a opção ligada, cada serviço fica bloqueado na data por agendamentos Agendados, Faturados ou Orçamentos com sinal. O bloqueio é por serviço."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Juros ao mês (%)" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtJuros" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Percentual"/>
                            <TextBlock Text="Juros simples por dia de atraso (÷ 30)." Style="{StaticResource TextoAuxiliar}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Multa (%)" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtMulta" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Percentual"/>
                            <TextBlock Text="Sobre a parcela vencida. Sugestão: 2%." Style="{StaticResource TextoAuxiliar}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Prazo de cancelamento (dias)" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtPrazo" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Inteiro" ctl:Mascara.Maximo="365"/>
                            <TextBlock Text="Cancelado até esse nº de dias antes do evento, tudo que foi pago é devolvido." Style="{StaticResource TextoAuxiliar}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,24,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}" Content="Salvar alterações" Click="BtnSalvarParametros_Click"/>
                        <TextBlock x:Name="TxtMensagemParametros" Style="{StaticResource TextoErro}" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ========================== Espécies de pagamento ========================== -->
        <Grid x:Name="PainelEspecies" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Cartao}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,0,12">
                        <Button DockPanel.Dock="Right" ctl:Estilo.Icone="{StaticResource IconeMais}" Content="Nova espécie" Click="BtnNovaEspecie_Click"/>
                        <StackPanel>
                            <TextBlock Text="Espécies" Style="{StaticResource TextoTituloSecao}"/>
                            <TextBlock Text="Dinheiro, pix, cartão... espécie usada não é excluída, é inativada." Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="ListaEspecies" Style="{StaticResource ListaLimpa}" SelectionChanged="ListaEspecies_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Height="52" Cursor="Hand">
                                        <Border x:Name="SeloInativa" DockPanel.Dock="Right" Style="{StaticResource Selo}" Visibility="Collapsed">
                                            <TextBlock Text="Inativa"/>
                                        </Border>
                                        <Border x:Name="SeloParcela" DockPanel.Dock="Right" Style="{StaticResource SeloDestaque}" Margin="0,0,8,0" Visibility="Collapsed">
                                            <TextBlock Text="Permite parcelar"/>
                                        </Border>
                                        <TextBlock Text="{Binding Descricao}" VerticalAlignment="Center" Foreground="{DynamicResource CorTexto}"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ativo}" Value="False">
                                            <Setter TargetName="SeloInativa" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PermiteParcelamento}" Value="True">
                                            <Setter TargetName="SeloParcela" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VazioEspecies" Text="Nenhuma espécie cadastrada." Style="{StaticResource TextoAuxiliar}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Cartao}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="TxtTituloEspecie" Text="Nova espécie" Style="{StaticResource TextoTituloSecao}" Margin="0,0,0,20"/>
                    <TextBlock Text="Descrição *" Style="{StaticResource TextoRotulo}"/>
                    <TextBox x:Name="TxtEspecieDescricao" Tag="Ex.: Cartão de crédito" MaxLength="80" Margin="0,0,0,20"/>
                    <CheckBox x:Name="ChkParcelamento" Style="{StaticResource Interruptor}" Content="Permite parcelamento"/>
                    <TextBlock Text="Sem essa opção, a espécie aceita só 1 parcela." Style="{StaticResource TextoAuxiliar}" Margin="52,4,0,16"/>
                    <CheckBox x:Name="ChkEspecieAtiva" Style="{StaticResource Interruptor}" Content="Ativa" IsChecked="True" Margin="0,0,0,24"/>
                    <TextBlock x:Name="TxtMensagemEspecie" Style="{StaticResource TextoErro}" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource BotaoPrincipal}" Content="Salvar espécie" HorizontalAlignment="Stretch" Click="BtnSalvarEspecie_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================ Empresa ================================ -->
        <ScrollViewer x:Name="PainelEmpresa" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Style="{StaticResource Cartao}" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados da empresa" Style="{StaticResource TextoTituloSecao}"/>
                    <TextBlock Text="Aparecem na navbar, na abertura do sistema e no catálogo em PDF." Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="96" Height="96" CornerRadius="12" Background="{DynamicResource CorSuperficieElevada}"
                                BorderBrush="{DynamicResource CorBorda}" BorderThickness="1">
                            <Grid>
                                <Image x:Name="ImgLogo" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <ctl:Icone x:Name="IconeSemLogo" Dados="{StaticResource IconeImagem}" Foreground="{DynamicResource CorTextoSecundario}"
                                           Width="28" Height="28"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Logo" FontWeight="Medium"/>
                            <TextBlock Text="PNG ou JPG. Ao salvar, é reduzida para no máximo 512 px e copiada para a pasta Arquivos\Empresa do sistema." Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button ctl:Estilo.Icone="{StaticResource IconeImagem}" Content="Escolher imagem" Margin="0,0,8,0" Click="BtnEscolherLogo_Click"/>
                                <Button x:Name="BtnRemoverLogo" Style="{StaticResource BotaoFantasma}" Content="Remover" Click="BtnRemoverLogo_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Nome *" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtEmpresaNome" MaxLength="120"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="CNPJ" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtEmpresaCnpj" Tag="00.000.000/0000-00" ctl:Mascara.Tipo="Cnpj" LostFocus="TxtEmpresaCnpj_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="Telefone" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtEmpresaTelefone" Tag="(49) 3333-4444" ctl:Mascara.Tipo="Telefone"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="E-mail" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtEmpresaEmail" Tag="contato@empresa.com.br" MaxLength="120"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                            <TextBlock Text="Endereço" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtEmpresaEndereco" Tag="Rua, número - Bairro, Cidade - UF" MaxLength="200"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,24,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}" Content="Salvar alterações" Click="BtnSalvarEmpresa_Click"/>
                        <TextBlock x:Name="TxtMensagemEmpresa" Style="{StaticResource TextoErro}" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- =============================== Aparência =============================== -->
        <StackPanel x:Name="PainelAparencia" Grid.Row="2" Visibility="Collapsed">
            <Border Style="{StaticResource Cartao}" HorizontalAlignment="Left" MaxWidth="820">
                <StackPanel>
                    <TextBlock Text="Tema" Style="{StaticResource TextoTituloSecao}"/>
                    <TextBlock Text="Aplicado na hora. A tela de abertura é sempre escura." Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,20"/>
                    <UniformGrid Columns="3" Margin="-8,0">
                        <!-- As miniaturas mostram as cores de cada tema, por isso usam cor fixa -->
                        <RadioButton x:Name="OpcaoClaro" Style="{StaticResource OpcaoCartao}" GroupName="Tema" Margin="8,0" Click="OpcaoTema_Click">
                            <StackPanel>
                                <Border Height="96" CornerRadius="8" Background="#F7F7F8" BorderBrush="#E4E4E7" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Border Width="36" HorizontalAlignment="Left" Background="#FFFFFF" CornerRadius="8,0,0,8" BorderBrush="#E4E4E7" BorderThickness="0,0,1,0"/>
                                        <StackPanel Margin="48,14,12,0">
                                            <Border Height="8" Width="64" CornerRadius="4" Background="#1C1B22" HorizontalAlignment="Left"/>
                                            <Border Height="30" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="1" Margin="0,10,0,0"/>
                                            <Border Height="10" Width="44" CornerRadius="4" Background="#6D3FC0" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ctl:Icone Dados="{StaticResource IconeClaro}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Claro" FontWeight="Medium"/>
                                    <TextBlock Text=" (padrão)" Style="{StaticResource TextoAuxiliar}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OpcaoEscuro" Style="{StaticResource OpcaoCartao}" GroupName="Tema" Margin="8,0" Click="OpcaoTema_Click">
                            <StackPanel>
                                <Border Height="96" CornerRadius="8" Background="#121214" BorderBrush="#2E2E35" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Border Width="36" HorizontalAlignment="Left" Background="#1B1B1F" CornerRadius="8,0,0,8"/>
                                        <StackPanel Margin="48,14,12,0">
                                            <Border Height="8" Width="64" CornerRadius="4" Background="#ECECEF" HorizontalAlignment="Left"/>
                                            <Border Height="30" CornerRadius="6" Background="#1B1B1F" BorderBrush="#2E2E35" BorderThickness="1" Margin="0,10,0,0"/>
                                            <Border Height="10" Width="44" CornerRadius="4" Background="#7C5AD9" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ctl:Icone Dados="{StaticResource IconeEscuro}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Escuro" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OpcaoSistema" Style="{StaticResource OpcaoCartao}" GroupName="Tema" Margin="8,0" Click="OpcaoTema_Click">
                            <StackPanel>
                                <Border Height="96" CornerRadius="8" BorderBrush="#CFCFD6" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F7F7F8" CornerRadius="8,0,0,8"/>
                                        <Border Grid.Column="1" Background="#121214" CornerRadius="0,8,8,0"/>
                                        <ctl:Icone Grid.ColumnSpan="2" Dados="{StaticResource IconeSistema}" Foreground="#6B6B76" Width="32" Height="32"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ctl:Icone Dados="{StaticResource IconeSistema}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Seguir o Windows" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================================ WhatsApp ================================ -->
        <ScrollViewer x:Name="PainelWhatsapp" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Style="{StaticResource Cartao}" MaxWidth="900" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- QR code (RF26): borrado quando desligado/desconectado, nítido aguardando a leitura, borrado com check quando conectado.
                         Preto no branco nos dois temas (é o que o celular lê), por isso cor fixa no fundo. -->
                    <StackPanel VerticalAlignment="Top">
                        <Border Width="240" Height="240" CornerRadius="12" Background="#FFFFFF" Padding="12"
                                BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ImgQr" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Effect>
                                        <BlurEffect x:Name="BorraoQr" Radius="14" KernelType="Gaussian"/>
                                    </Image.Effect>
                                </Image>
                                <!-- Conectado: check verde por cima do QR borrado -->
                                <Border x:Name="SeloConectadoQr" Width="88" Height="88" CornerRadius="44" Background="{DynamicResource CorSucesso}"
                                        Visibility="Collapsed">
                                    <ctl:Icone Dados="{StaticResource IconeCheck}" Foreground="#FFFFFF" Width="44" Height="44"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TxtLegendaQr" Style="{StaticResource TextoAuxiliar}" Width="240" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <CheckBox x:Name="ChkWhatsappAtivo" DockPanel.Dock="Right" Style="{StaticResource Interruptor}" Content="Ativo"
                                      VerticalAlignment="Center" Click="ChkWhatsappAtivo_Click"/>
                            <StackPanel>
                                <TextBlock Text="WhatsApp" Style="{StaticResource TextoTituloSecao}" FontSize="18"/>
                                <TextBlock Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"
                                           Text="Envie catálogo e orçamentos para os clientes pelo WhatsApp do espaço."/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Estado em texto, não só cor -->
                        <Border x:Name="SeloEstadoWhatsapp" Style="{StaticResource Selo}" Padding="12,6" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PontoEstado" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource CorTextoSecundario}"/>
                                <TextBlock x:Name="TxtEstadoWhatsapp" Text="WhatsApp desligado" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtInstrucaoQr" Style="{StaticResource TextoAuxiliar}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20"
                                   Visibility="Collapsed"
                                   Text="No celular do espaço, abra o WhatsApp → Configurações → Aparelhos conectados → Conectar um aparelho, e aponte para o QR code."/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnConectar" Style="{StaticResource BotaoPrincipal}" Content="Conectar" Margin="0,0,8,0" Click="BtnConectar_Click"/>
                            <Button x:Name="BtnDesconectar" Style="{StaticResource BotaoPerigo}" Content="Desconectar" Click="BtnDesconectar_Click"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CorBorda}" Margin="0,24,0,20"/>

                        <!-- Mensagens padrão e acompanhamento dos envios (popups) -->
                        <UniformGrid Columns="2" Margin="-6,0">
                            <Button Margin="6,0" Height="64" HorizontalContentAlignment="Left" Padding="16,0" Click="BtnMensagens_Click"
                                    ToolTip="Editar os textos padrão do catálogo e do orçamento">
                                <StackPanel Orientation="Horizontal">
                                    <ctl:Icone Dados="{StaticResource IconeMensagem}" Foreground="{DynamicResource CorDestaque}" Width="22" Height="22"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Mensagens" FontWeight="SemiBold"/>
                                        <TextBlock Text="Textos padrão" Style="{StaticResource TextoAuxiliar}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0" Height="64" HorizontalContentAlignment="Left" Padding="16,0" Click="BtnEnvios_Click"
                                    ToolTip="Ver o que foi enviado e reenviar o que falhou">
                                <StackPanel Orientation="Horizontal">
                                    <ctl:Icone Dados="{StaticResource IconeEnvios}" Foreground="{DynamicResource CorDestaque}" Width="22" Height="22"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Envios" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtResumoEnvios" Text="Acompanhar envios" Style="{StaticResource TextoAuxiliar}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <StackPanel Width="190">
                                <TextBlock Text="Limite de mensagens por dia" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtLimiteDiario" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Inteiro" ctl:Mascara.Maximo="200"/>
                            </StackPanel>
                            <Button Content="Salvar" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="BtnSalvarLimite_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtMensagemWhatsapp" Style="{StaticResource TextoErro}" FontSize="13" Margin="0,8,0,0"/>

                        <!-- Risco da biblioteca não oficial: nota discreta, sem caixa -->
                        <TextBlock Style="{StaticResource TextoAuxiliar}" Opacity="0.65" LineHeight="18" Margin="0,16,0,0"
                                   Text="A conexão usa uma biblioteca não oficial e o WhatsApp pode bloquear números que enviam muitas mensagens. Use um número só do negócio, envie para quem já é cliente e mantenha o limite baixo."/>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- ================================= Sobre ================================= -->
        <ScrollViewer x:Name="PainelSobre" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Style="{StaticResource Cartao}" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="720">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- Respiro de 16 px em volta da logo -->
                        <Border Width="72" Height="72" CornerRadius="12" Background="{DynamicResource CorSuperficieElevada}" Padding="16">
                            <Image Source="{DynamicResource ImagemLogoUnc}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Fest Agenda" FontFamily="{StaticResource FonteMarca}" FontSize="24" Foreground="{DynamicResource CorTexto}"/>
                            <TextBlock x:Name="TxtVersao" Style="{StaticResource TextoAuxiliar}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Sistema de gestão de agendamentos, serviços e financeiro para espaços de festas."
                               Style="{StaticResource TextoAuxiliar}" FontSize="14" Margin="0,20,0,20"/>

                    <Border Height="1" Background="{DynamicResource CorBorda}" Margin="0,0,0,20"/>

                    <TextBlock Text="Desenvolvido por acadêmicos da Universidade do Contestado (UnC)" Margin="0,0,0,16" FontWeight="Medium"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Curso" Style="{StaticResource TextoAuxiliar}" FontSize="14"/>
                        <TextBlock Grid.Column="1" Text="Engenharia de Software"/>
                        <TextBlock Grid.Row="1" Text="Grupo" Style="{StaticResource TextoAuxiliar}" FontSize="14"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Bruno Balbinott, Eduardo Metzdorf e Marco Dall Bello" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Professores" Style="{StaticResource TextoAuxiliar}" FontSize="14"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Eduardo Pilonetto e Moacir Kichel" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Text="Versão" Style="{StaticResource TextoAuxiliar}" FontSize="14"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtVersaoDetalhe"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource CorBorda}" Margin="0,20,0,16"/>
                    <TextBlock Style="{StaticResource TextoAuxiliar}" FontSize="14" FontStyle="Italic" TextWrapping="Wrap" LineHeight="22"
                               Text="Feito com dedicação para transformar cada festa em uma boa história. Obrigado por fazer parte do nosso projeto."/>
