<Window x:Class="EspacoFestas.Views.ModelosMensagemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EspacoFestas.Controls"
        Title="Mensagens padrão" Width="900" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FonteInter}" FontSize="14" Foreground="{DynamicResource CorTexto}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Mensagens padrão do WhatsApp: escolhe a mensagem na lista e edita. Os campos aparecem como etiquetas coloridas
         ("Cliente", "Data do evento") e são preenchidos sozinhos no envio. -->
    <Window.Resources>
        <!-- Botão que insere um campo: mesma cor da etiqueta, com "+" -->
        <Style x:Key="BotaoCampo" TargetType="Button" BasedOn="{StaticResource BotaoFantasma}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource CorPrincipalFundo}"/>
            <Setter Property="Foreground" Value="{DynamicResource CorDestaque}"/>
            <Setter Property="ctl:Estilo.CorHover" Value="{DynamicResource CorPrincipalFundo}"/>
            <Setter Property="ctl:Estilo.Icone" Value="{StaticResource IconeMais}"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Background="Transparent"
                    MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <DockPanel Margin="24,20,16,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeFechar}"
                            VerticalAlignment="Top" ToolTip="Fechar (Esc)" Click="BtnFechar_Click"/>
                    <StackPanel>
                        <TextBlock Text="Mensagens padrão" Style="{StaticResource TextoTituloSecao}" FontSize="20"/>
                        <TextBlock Text="Escolha a mensagem e edite. Os campos coloridos são preenchidos sozinhos na hora do envio."
                                   Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ListaModelos" Style="{StaticResource ListaLimpa}" SelectionChanged="ListaModelos_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,12" Cursor="Hand">
                                <TextBlock Text="{Binding Titulo}" FontWeight="Medium" Foreground="{DynamicResource CorTexto}"/>
                                <TextBlock Text="{Binding Descricao}" Style="{StaticResource TextoAuxiliar}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Texto da mensagem" Style="{StaticResource TextoRotulo}"/>
                        <RichTextBox x:Name="Editor" Height="190" TextChanged="Editor_TextChanged"/>

                        <TextBlock Text="Inserir campo" Style="{StaticResource TextoRotulo}" Margin="0,14,0,8"/>
                        <WrapPanel x:Name="PainelCampos"/>
                        <TextBlock Style="{StaticResource TextoAuxiliar}" Margin="0,2,0,0"
                                   Text="Clique para inserir onde está o cursor. Para tirar, apague como uma letra. *Texto entre asteriscos* sai em negrito."/>

                        <TextBlock Text="Prévia (com dados de exemplo)" Style="{StaticResource TextoRotulo}" Margin="0,18,0,8"/>
                        <!-- Balão parecido com o do WhatsApp -->
                        <Border Background="{DynamicResource CorSucessoFundo}" CornerRadius="0,12,12,12" Padding="14,10" HorizontalAlignment="Left" MaxWidth="460">
                            <TextBlock x:Name="TxtPrevia" TextWrapping="Wrap" LineHeight="20"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,1,0,0" Padding="24,16">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource BotaoFantasma}" Content="Restaurar o texto padrão" Click="BtnRestaurar_Click"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Fechar" Style="{StaticResource BotaoFantasma}" Margin="0,0,8,0" Click="BtnFechar_Click"/>
                        <Button Content="Salvar mensagem" Style="{StaticResource BotaoPrincipal}" Click="BtnSalvar_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource TextoAuxiliar}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
