<Window x:Class="EspacoFestas.Views.EnvioWhatsappWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EspacoFestas.Controls"
        Title="Enviar pelo WhatsApp" Width="600" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FonteInter}" FontSize="14" Foreground="{DynamicResource CorTexto}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Envio pelo WhatsApp (RF28 catálogo, RF29 orçamento): ela revisa o texto e confirma; "Copiar texto" serve de alternativa
         quando o WhatsApp está desconectado. Falha nunca desfaz nada (RN30). -->
    <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Background="Transparent"
                    MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <DockPanel Margin="24,20,16,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeFechar}"
                            VerticalAlignment="Top" ToolTip="Fechar (Esc)" Click="BtnCancelar_Click"/>
                    <StackPanel>
                        <TextBlock Text="Enviar pelo WhatsApp" Style="{StaticResource TextoTituloSecao}" FontSize="20"/>
                        <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,8">
                <StackPanel Margin="0,16,0,0">
                    <!-- Estado da conexão: texto, não só cor -->
                    <Border x:Name="CaixaEstado" Style="{StaticResource Selo}" HorizontalAlignment="Stretch" Padding="12,10">
                        <TextBlock x:Name="TxtEstado" Text="Verificando o WhatsApp..." TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Cliente *" Style="{StaticResource TextoRotulo}" Margin="0,16,0,0"/>
                    <ComboBox x:Name="CmbCliente" IsTextSearchEnabled="True" MaxDropDownHeight="280" SelectionChanged="CmbCliente_SelectionChanged"/>
                    <TextBlock x:Name="TxtCliente" FontWeight="SemiBold" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtTelefone" Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtMotivo" Style="{StaticResource TextoErro}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="TxtAnexo" Style="{StaticResource TextoAuxiliar}" Margin="0,12,0,0" Visibility="Collapsed"
                               Text="Anexo: catálogo de serviços em PDF, com os preços atuais."/>

                    <TextBlock Text="Mensagem *" Style="{StaticResource TextoRotulo}" Margin="0,16,0,0"/>
                    <TextBox x:Name="TxtMensagem" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Height="220" VerticalContentAlignment="Top" Padding="12,10" MaxLength="2000" TextChanged="TxtMensagem_TextChanged"/>
                    <TextBlock Style="{StaticResource TextoAuxiliar}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="O texto pode ser ajustado antes de enviar. *Texto entre asteriscos* sai em negrito no WhatsApp."/>

                    <TextBlock x:Name="TxtErro" Style="{StaticResource TextoErro}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,1,0,0" Padding="24,16">
                <DockPanel>
                    <TextBlock x:Name="TxtEnviando" Style="{StaticResource TextoAuxiliar}" VerticalAlignment="Center" Visibility="Collapsed"
                               Text="Enviando... pode levar alguns segundos."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                        <Button x:Name="BtnCopiar" Content="Copiar texto" Margin="0,0,8,0" Click="BtnCopiar_Click"
                                ToolTip="Copia a mensagem para colar no WhatsApp do celular ou do computador"/>
                        <Button x:Name="BtnEnviar" Content="Enviar" Style="{StaticResource BotaoPrincipal}" IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True" Click="BtnEnviar_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
