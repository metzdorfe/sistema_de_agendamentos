<UserControl x:Class="EspacoFestas.Views.FinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EspacoFestas.Controls">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <ComboBox x:Name="CmbPeriodo" DockPanel.Dock="Right" Width="200" VerticalAlignment="Top"
                      SelectionChanged="CmbPeriodo_SelectionChanged"/>
            <StackPanel>
                <TextBlock Text="Financeiro" Style="{StaticResource TextoTituloTela}"/>
                <TextBlock Text="Acompanhe faturamento, recebimentos e o caixa." Style="{StaticResource TextoSubtitulo}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource GrupoAbas}" Margin="0,24,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AbaVisaoGeral" Style="{StaticResource Aba}" Content="Visão geral" GroupName="AbasFinanceiro" Click="Aba_Click"/>
                <RadioButton x:Name="AbaReceber" Style="{StaticResource Aba}" Content="Contas a receber" GroupName="AbasFinanceiro" Click="Aba_Click"/>
                <RadioButton x:Name="AbaCaixa" Style="{StaticResource Aba}" Content="Caixa" GroupName="AbasFinanceiro" Click="Aba_Click"/>
            </StackPanel>
        </Border>

        <!-- ============================ Visão geral ============================ -->
        <Grid x:Name="PainelVisaoGeral" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="4" Margin="-8,0,-8,16">
                <Border Style="{StaticResource Cartao}" Margin="8,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Total faturado" Style="{StaticResource TextoAuxiliar}"/>
                        <TextBlock x:Name="TxtFaturado" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" Style="{StaticResource TextoValor}"/>
                        <TextBlock x:Name="TxtFaturadoVariacao" Style="{StaticResource TextoAuxiliar}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Cartao}" Margin="8,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Recebido" Style="{StaticResource TextoAuxiliar}"/>
                        <TextBlock x:Name="TxtRecebido" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" Style="{StaticResource TextoValor}"/>
                        <TextBlock x:Name="TxtRecebidoVariacao" Style="{StaticResource TextoAuxiliar}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Cartao}" Margin="8,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Em aberto" Style="{StaticResource TextoAuxiliar}"/>
                        <TextBlock x:Name="TxtAberto" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" Style="{StaticResource TextoValor}"/>
                        <TextBlock x:Name="TxtAbertoDetalhe" Style="{StaticResource TextoAuxiliar}"/>
                    </StackPanel>
                </Border>
                <!-- Parcelas vencidas: destaque próprio em vermelho -->
                <Border x:Name="CartaoVencidas" Style="{StaticResource Cartao}" Margin="8,0" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ctl:Icone x:Name="IconeVencidas" Dados="{StaticResource IconeAlerta}" Width="14" Height="14" Margin="0,0,6,0"
                                       Foreground="{DynamicResource CorErro}"/>
                            <TextBlock Text="Vencidas" Style="{StaticResource TextoAuxiliar}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtVencidas" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" Style="{StaticResource TextoValor}"/>
                        <TextBlock x:Name="TxtVencidasDetalhe" Style="{StaticResource TextoAuxiliar}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Cartao}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtTituloGrafico" Text="Faturamento" Style="{StaticResource TextoTituloSecao}"/>
                            <TextBlock x:Name="TxtSubtituloGrafico" Text="Eventos faturados, pela data do evento" Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid x:Name="Grafico"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Cartao}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Últimos lançamentos" Style="{StaticResource TextoTituloSecao}" Margin="0,0,0,12"/>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ListaLancamentos"/>
                            </ScrollViewer>
                            <TextBlock x:Name="VazioLancamentos" Text="Nenhum lançamento no caixa ainda." Style="{StaticResource TextoAuxiliar}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================== Contas a receber ========================== -->
        <DockPanel x:Name="PainelReceber" Grid.Row="2" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button x:Name="BtnBaixa" DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}" Content="Dar baixa" IsEnabled="False"
                        ctl:Estilo.Icone="{StaticResource IconeReceber}" ToolTip="Selecione uma parcela em aberto" ToolTipService.ShowOnDisabled="True"
                        Click="BtnBaixa_Click"/>
                <Border Style="{StaticResource GrupoAbas}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FiltroAbertas" Style="{StaticResource Aba}" Content="Em aberto" IsChecked="True" GroupName="FiltroReceber" Click="FiltroReceber_Click"/>
                        <RadioButton x:Name="FiltroVencidas" Style="{StaticResource Aba}" Content="Vencidas" GroupName="FiltroReceber" Click="FiltroReceber_Click"/>
                        <RadioButton x:Name="FiltroPagas" Style="{StaticResource Aba}" Content="Pagas" GroupName="FiltroReceber" Click="FiltroReceber_Click"/>
                        <RadioButton x:Name="FiltroTodas" Style="{StaticResource Aba}" Content="Todas" GroupName="FiltroReceber" Click="FiltroReceber_Click"/>
                    </StackPanel>
                </Border>
            </DockPanel>
            <Border Style="{StaticResource Cartao}" Padding="8,4">
                <Grid>
                    <DataGrid x:Name="GradeReceber" SelectionChanged="GradeReceber_SelectionChanged" MouseDoubleClick="GradeReceber_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vencimento" Binding="{Binding Vencimento}" Width="128"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="2*" ElementStyle="{StaticResource CelulaNegrito}"/>
                            <DataGridTextColumn Header="Evento" Binding="{Binding Evento}" Width="2*" ElementStyle="{StaticResource CelulaTexto}"/>
                            <DataGridTextColumn Header="Parcela" Binding="{Binding Parcela}" Width="88"/>
                            <DataGridTextColumn Header="Espécie" Binding="{Binding Especie}" Width="*" ElementStyle="{StaticResource CelulaTexto}"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="136"
                                                ElementStyle="{StaticResource CelulaDireita}" HeaderStyle="{StaticResource CabecalhoDireita}"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Selo" Style="{StaticResource Selo}">
                                            <TextBlock Text="{Binding Status}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Vencida">
                                                <Setter TargetName="Selo" Property="Style" Value="{StaticResource SeloErro}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Paga">
                                                <Setter TargetName="Selo" Property="Style" Value="{StaticResource SeloSucesso}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Aberta">
                                                <Setter TargetName="Selo" Property="Style" Value="{StaticResource SeloDestaque}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="VazioReceber" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ctl:Icone Dados="{StaticResource IconeReceber}" Foreground="{DynamicResource CorTextoSecundario}" Width="40" Height="40"/>
                        <TextBlock Text="Nenhuma parcela aqui" Style="{StaticResource TextoTituloSecao}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="As parcelas aparecem aqui ao faturar um agendamento com parcelamento." Style="{StaticResource TextoAuxiliar}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ================================ Caixa ================================ -->
        <DockPanel x:Name="PainelCaixa" Grid.Row="2" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}" ctl:Estilo.Icone="{StaticResource IconeMais}"
                        Content="Lançamento avulso" IsEnabled="False" VerticalAlignment="Center"
                        ToolTip="Lançamentos avulsos, despesas do evento e estornos: em desenvolvimento" ToolTipService.ShowOnDisabled="True"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="Entradas" Style="{StaticResource TextoAuxiliar}"/>
                        <TextBlock x:Name="TxtEntradas" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource CorSucesso}" Style="{StaticResource TextoValor}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="Saídas" Style="{StaticResource TextoAuxiliar}"/>
                        <TextBlock x:Name="TxtSaidas" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource CorErro}" Style="{StaticResource TextoValor}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Saldo do período" Style="{StaticResource TextoAuxiliar}"/>
                        <TextBlock x:Name="TxtSaldo" FontSize="18" FontWeight="SemiBold" Style="{StaticResource TextoValor}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Cartao}" Padding="8,4">
                <Grid>
                    <DataGrid x:Name="GradeCaixa">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="128"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*" ElementStyle="{StaticResource CelulaNegrito}"/>
                            <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="2*" ElementStyle="{StaticResource CelulaTexto}"/>
                            <DataGridTextColumn Header="Espécie" Binding="{Binding Especie}" Width="*" ElementStyle="{StaticResource CelulaTexto}"/>
                            <DataGridTemplateColumn Header="Valor" Width="140" HeaderStyle="{StaticResource CabecalhoDireita}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="TxtValor" Text="{Binding Valor}" HorizontalAlignment="Right" FontWeight="Medium"
                                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource CorSucesso}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Entrada}" Value="False">
                                                <Setter TargetName="TxtValor" Property="Foreground" Value="{DynamicResource CorErro}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="VazioCaixa" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ctl:Icone Dados="{StaticResource IconeCaixa}" Foreground="{DynamicResource CorTextoSecundario}" Width="40" Height="40"/>
                        <TextBlock Text="Nenhum lançamento no período" Style="{StaticResource TextoTituloSecao}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="Entradas e saídas aparecem aqui conforme acontecem." Style="{StaticResource TextoAuxiliar}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
