<Window x:Class="EspacoFestas.Views.BaixaParcelaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EspacoFestas.Controls"
        Title="Receber parcela" Width="600" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FonteInter}" FontSize="14" Foreground="{DynamicResource CorTexto}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Baixa da parcela (RN18–RN20): dados da parcela, multa e juros calculados pela data do recebimento,
         espécie usada e valor pago. Pago menor que o total: gera parcela com a diferença ou perdoa. -->
    <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Background="Transparent"
                    MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <DockPanel Margin="24,20,16,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeFechar}"
                            VerticalAlignment="Top" ToolTip="Fechar (Esc)" Click="BtnCancelar_Click"/>
                    <StackPanel>
                        <TextBlock Text="Receber parcela" Style="{StaticResource TextoTituloSecao}" FontSize="20"/>
                        <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,8">
                <StackPanel Margin="0,16,0,0">
                    <!-- Dados da parcela -->
                    <Border Style="{StaticResource Cartao}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cliente" Style="{StaticResource TextoAuxiliar}" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtCliente" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="Evento" Style="{StaticResource TextoAuxiliar}" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtEvento" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="Parcela" Style="{StaticResource TextoAuxiliar}" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtParcela" Grid.Row="2" Grid.Column="1"/>
                            <TextBlock Grid.Row="3" Text="Espécie combinada" Style="{StaticResource TextoAuxiliar}" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtEspecieCombinada" Grid.Row="3" Grid.Column="1"/>
                            <TextBlock Grid.Row="4" Text="Vencimento" Style="{StaticResource TextoAuxiliar}" FontSize="14" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="TxtVencimento"/>
                                <Border x:Name="SeloAtraso" Style="{StaticResource SeloErro}" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAtraso"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="5" Text="Valor da parcela" Style="{StaticResource TextoAuxiliar}" FontSize="14"/>
                            <TextBlock x:Name="TxtValorParcela" Grid.Row="5" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- Recebimento -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Data do recebimento *" Style="{StaticResource TextoRotulo}"/>
                            <Grid x:Name="CaixaData">
                                <TextBox x:Name="TxtData" Tag="dd/mm/aaaa" ctl:Mascara.Tipo="Data" Padding="12,0,36,0" LostFocus="TxtData_LostFocus"/>
                                <Button Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeAgenda}" HorizontalAlignment="Right"
                                        Margin="0,0,4,0" Focusable="False" ToolTip="Escolher no calendário" Click="BtnCalendario_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Espécie usada *" Style="{StaticResource TextoRotulo}"/>
                            <ComboBox x:Name="CmbEspecie" ToolTip="Pode ser diferente da combinada (RN20)"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Multa (R$)" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtMulta" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Moeda" Tag="0,00" TextChanged="Valores_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Juros (R$)" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtJuros" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Moeda" Tag="0,00" TextChanged="Valores_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <TextBlock Text="Total devido" Style="{StaticResource TextoRotulo}"/>
                            <TextBlock x:Name="TxtTotal" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource CorEnfase}" Margin="0,4,0,6"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtRegraJuros" Style="{StaticResource TextoAuxiliar}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="Valor pago *" Style="{StaticResource TextoRotulo}" Margin="0,16,0,0"/>
                    <TextBox x:Name="TxtRecebido" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Moeda" Tag="0,00" Width="200"
                             HorizontalAlignment="Left" TextChanged="Valores_Changed"/>

                    <!-- RN19: pagou menos que o total -->
                    <Border x:Name="PainelDiferenca" Style="{StaticResource Cartao}" Padding="16" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtDiferenca" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton x:Name="OpcaoNovaParcela" Style="{StaticResource OpcaoRadio}" GroupName="Diferenca" IsChecked="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Gerar nova parcela para" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtVencimentoDiferenca" Width="120" MinHeight="32" Margin="8,0,0,0" ctl:Mascara.Tipo="Data"
                                                 GotFocus="TxtVencimentoDiferenca_GotFocus"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="OpcaoPerdoar" Style="{StaticResource OpcaoRadio}" GroupName="Diferenca" Content="Perdoar a diferença"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtErro" Style="{StaticResource TextoErro}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                    <Button Content="Confirmar recebimento" Style="{StaticResource BotaoPrincipal}" Click="BtnConfirmar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
