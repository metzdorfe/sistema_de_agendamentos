<Window x:Class="EspacoFestas.Views.AgendamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EspacoFestas.Controls"
        xmlns:v="clr-namespace:EspacoFestas.Views"
        Title="Agendamento" Width="900" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FonteInter}" FontSize="14" Foreground="{DynamicResource CorTexto}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Popup modal por cima da tela atual (o fundo escurece pela MainWindow.MostrarModal).
         Ordem: cliente → evento → serviço (faixas) → adicionais; resumo e botões fixos no rodapé. -->
    <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================== Cabeçalho ============================== -->
            <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Background="Transparent"
                    MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
            <DockPanel Margin="24,20,16,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeFechar}"
                        VerticalAlignment="Top" ToolTip="Fechar (Esc)" Click="BtnCancelar_Click"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtTitulo" Text="Novo agendamento" Style="{StaticResource TextoTituloSecao}" FontSize="20" VerticalAlignment="Center"/>
                    <Border x:Name="SeloStatus" Style="{StaticResource Selo}" Margin="12,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtStatus"/>
                    </Border>
                </StackPanel>
            </DockPanel>
            </Border>

            <!-- ============================== Conteúdo (rola) ============================== -->
            <ScrollViewer x:Name="Rolagem" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
                <StackPanel x:Name="Conteudo" Margin="0,16,0,0">
                    <!-- Aviso de somente leitura (faturado / cancelado) -->
                    <Border x:Name="AvisoSomenteLeitura" Style="{StaticResource Selo}" HorizontalAlignment="Stretch" Padding="12,10"
                            CornerRadius="8" Margin="0,0,0,16" Visibility="Collapsed">
                        <DockPanel>
                            <ctl:Icone DockPanel.Dock="Left" Dados="{StaticResource IconeInfo}" Foreground="{DynamicResource CorTextoSecundario}"
                                       Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="TxtSomenteLeitura" TextWrapping="Wrap" FontWeight="Normal" FontSize="13"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="TxtErroGeral" Style="{StaticResource TextoErro}" FontSize="13" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- 1. Cliente -->
                    <TextBlock Text="Cliente" Style="{StaticResource TextoTituloSecao}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCliente" ctl:Estilo.Icone="{StaticResource IconeBuscar}" Tag="Buscar por nome, telefone ou CPF/CNPJ"
                                 MaxLength="120" TextChanged="TxtCliente_TextChanged" PreviewKeyDown="TxtCliente_PreviewKeyDown"
                                 GotKeyboardFocus="TxtCliente_GotKeyboardFocus"/>
                        <Button x:Name="BtnNovoCliente" Grid.Column="1" ctl:Estilo.Icone="{StaticResource IconeMais}" Margin="8,0,0,0"
                                Padding="12,0" ToolTip="Cadastro rápido de cliente" Click="BtnNovoCliente_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtClienteDetalhe" Style="{StaticResource TextoAuxiliar}" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ErroCliente" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <Popup x:Name="PopupClientes" PlacementTarget="{Binding ElementName=TxtCliente}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Width="{Binding ActualWidth, ElementName=TxtCliente}">
                        <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1"
                                CornerRadius="8" Padding="4" Margin="0,4,0,0" MaxHeight="280">
                            <ListBox x:Name="ListaClientes" Style="{StaticResource ListaLimpa}" KeyboardNavigation.DirectionalNavigation="Cycle"
                                     PreviewMouseLeftButtonUp="ListaClientes_PreviewMouseLeftButtonUp" PreviewKeyDown="ListaClientes_PreviewKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type v:ClienteOpcao}">
                                        <StackPanel Margin="4,8" Cursor="Hand">
                                            <TextBlock Text="{Binding Nome}" Foreground="{DynamicResource CorTexto}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource TextoAuxiliar}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <!-- 2. Evento -->
                    <TextBlock Text="Evento" Style="{StaticResource TextoTituloSecao}" Margin="0,28,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Título *" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtTituloEvento" Tag="Ex.: Festa Infantil, Casamento" MaxLength="80"/>
                            <TextBlock x:Name="ErroTitulo" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data *" Style="{StaticResource TextoRotulo}"/>
                            <Grid x:Name="CaixaData">
                                <TextBox x:Name="TxtData" Tag="dd/mm/aaaa" ctl:Mascara.Tipo="Data" Padding="12,0,36,0" LostFocus="TxtData_LostFocus"/>
                                <Button Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeAgenda}" HorizontalAlignment="Right"
                                        Margin="0,0,4,0" Focusable="False" ToolTip="Escolher no calendário" Click="BtnCalendario_Click"/>
                            </Grid>
                            <TextBlock x:Name="ErroData" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtDiaSemana" Style="{StaticResource TextoAuxiliar}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Início *" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtInicio" Tag="hh:mm" ctl:Mascara.Tipo="Hora" LostFocus="Hora_LostFocus"/>
                            <TextBlock x:Name="ErroInicio" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Fim *" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtFim" Tag="hh:mm" ctl:Mascara.Tipo="Hora" LostFocus="Hora_LostFocus"/>
                            <TextBlock x:Name="ErroFim" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Convidados" Style="{StaticResource TextoRotulo}"/>
                            <TextBox x:Name="TxtConvidados" Style="{StaticResource CampoValor}" Tag="0" ctl:Mascara.Tipo="Inteiro"/>
                            <TextBlock x:Name="ErroConvidados" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <!-- RN28: fim menor que o início = termina no dia seguinte -->
                    <StackPanel x:Name="AvisoDiaSeguinte" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <ctl:Icone Dados="{StaticResource IconeInfo}" Foreground="{DynamicResource CorTextoSecundario}" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Termina no dia seguinte." Style="{StaticResource TextoAuxiliar}"/>
                    </StackPanel>

                    <!-- 3. Serviço -->
                    <DockPanel Margin="0,28,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="PainelAdicionarServico">
                            <ComboBox x:Name="CmbServico" Width="240" DisplayMemberPath="Nome" MaxDropDownHeight="280" Tag="Escolha o serviço"
                                      SelectionChanged="CmbServico_SelectionChanged"/>
                            <Button x:Name="BtnAdicionarServico" ctl:Estilo.Icone="{StaticResource IconeMais}" Content="Adicionar" Margin="8,0,0,0"
                                    IsEnabled="False" Click="BtnAdicionarServico_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Serviço" Style="{StaticResource TextoTituloSecao}"/>
                            <TextBlock x:Name="TxtAjudaServico" Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"
                                       Text="Escolha o serviço e marque a faixa de preço; o valor pode ser ajustado."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ErroServicos" Style="{StaticResource TextoErro}" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBlock x:Name="VazioServicos" Text="Nenhum serviço adicionado." Style="{StaticResource TextoAuxiliar}" FontSize="14"/>
                    <ItemsControl x:Name="ListaServicos" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:ServicoLinhaAgendamento}">
                                <Border x:Name="Cartao" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="12"
                                        Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeExcluir}"
                                                    ToolTip="Remover serviço" Click="BtnRemoverServico_Click"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                                                <TextBlock Text="Valor (R$)" Style="{StaticResource TextoRotulo}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox Width="128" Style="{StaticResource CampoValor}" Tag="0,00" ctl:Mascara.Tipo="Moeda"
                                                         Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"
                                                         ctl:Estilo.Erro="{Binding TemErro}" LostFocus="ValorServico_LostFocus"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Faixas}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type v:FaixaOpcao}">
                                                    <RadioButton Style="{StaticResource OpcaoRadio}" IsChecked="{Binding Selecionada, Mode=OneWay}"
                                                                 GroupName="{Binding DataContext.Grupo, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 Checked="Faixa_Checked">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Nome}"/>
                                                            <TextBlock Text="{Binding ValorTexto}" Style="{StaticResource TextoAuxiliar}" Margin="8,0,0,0"
                                                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                                        </StackPanel>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Erro}" Style="{StaticResource TextoErro}" Margin="0,4,0,0" x:Name="ErroLinha" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding TemErro}" Value="True">
                                        <Setter TargetName="ErroLinha" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Cartao" Property="BorderBrush" Value="{DynamicResource CorErro}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 4. Adicionais -->
                    <TextBlock Text="Adicionais" Style="{StaticResource TextoTituloSecao}" Margin="0,20,0,4"/>
                    <TextBlock Text="Só os adicionais oferecidos pelo(s) serviço(s) escolhido(s). O custo aparece em cinza, para ver o lucro."
                               Style="{StaticResource TextoAuxiliar}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="VazioAdicionais" Text="Escolha um serviço para ver os adicionais." Style="{StaticResource TextoAuxiliar}" FontSize="14"/>
                    <Grid x:Name="CabecalhoAdicionais" Margin="8,0,8,4" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ADICIONAL" Style="{StaticResource TextoRotulo}" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="QTD." Style="{StaticResource TextoRotulo}" Margin="0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="VALOR UNIT. (R$)" Style="{StaticResource TextoRotulo}" Margin="0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="TOTAL" Style="{StaticResource TextoRotulo}" Margin="0" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl x:Name="ListaAdicionais" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type v:AdicionalLinhaAgendamento}">
                                <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Padding="8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <CheckBox Content="{Binding Nome}" IsChecked="{Binding Selecionado}"/>
                                            <TextBlock Text="{Binding CustoTexto}" Style="{StaticResource TextoAuxiliar}" Margin="26,2,0,0"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                        <TextBox x:Name="CampoQuantidade" Grid.Column="1" Style="{StaticResource CampoValor}" ctl:Mascara.Tipo="Inteiro" Tag="1"
                                                 Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 ctl:Estilo.Erro="{Binding QuantidadeErro}" IsEnabled="{Binding Selecionado}"/>
                                        <TextBlock x:Name="QuantidadeFixa" Grid.Column="1" Text="1" Style="{StaticResource TextoAuxiliar}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"
                                                   ToolTip="Valor fixo (não cobra por quantidade)"/>
                                        <TextBox Grid.Column="3" Style="{StaticResource CampoValor}" Tag="0,00" ctl:Mascara.Tipo="Moeda"
                                                 Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 ctl:Estilo.Erro="{Binding ValorErro}" IsEnabled="{Binding Selecionado}"
                                                 LostFocus="ValorAdicional_LostFocus"/>
                                        <TextBlock Grid.Column="5" Text="{Binding TotalTexto}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CobraPorQuantidade}" Value="False">
                                        <Setter TargetName="CampoQuantidade" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="QuantidadeFixa" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- RF16: lucro do evento, só depois de faturado -->
                    <Border x:Name="PainelLucro" Style="{StaticResource Cartao}" Padding="16" Margin="0,24,0,0" Visibility="Collapsed">
                        <StackPanel Typography.NumeralAlignment="Tabular">
                            <TextBlock Text="Lucro do evento" Style="{StaticResource TextoTituloSecao}"/>
                            <TextBlock x:Name="TxtLucroAviso" Style="{StaticResource TextoAuxiliar}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Receita (total do evento)" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLucroReceita" Grid.Column="1" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="Custo dos adicionais" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLucroCusto" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Text="Despesas lançadas no caixa" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtLucroDespesas" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"/>
                                <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock x:Name="TxtLucro" DockPanel.Dock="Right" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Lucro" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="ListaDespesas" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== Rodapé fixo: resumo + botões ============================== -->
            <Border Grid.Row="2" Background="{DynamicResource CorSuperficieElevada}" BorderBrush="{DynamicResource CorBorda}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="24,16,24,20">
                <StackPanel>
                    <Grid x:Name="Resumo" Typography.NumeralAlignment="Tabular">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Serviços" Style="{StaticResource TextoRotulo}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSubtotalServicos" Text="R$ 0,00" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Adicionais" Style="{StaticResource TextoRotulo}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSubtotalAdicionais" Text="R$ 0,00" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <TextBlock Text="Desconto (R$)" Style="{StaticResource TextoRotulo}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDesconto" Style="{StaticResource CampoValor}" Width="112" MinHeight="32" Tag="0,00" ctl:Mascara.Tipo="Moeda"
                                     TextChanged="Totais_TextChanged" LostFocus="TxtDesconto_LostFocus"/>
                        </StackPanel>
                        <!-- Sinal (opcional): vai direto para o caixa, ligado ao agendamento (RN12) -->
                        <StackPanel x:Name="PainelSinal" Grid.Column="6" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtRotuloSinal" Text="Sinal (opcional)" Style="{StaticResource TextoRotulo}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtSinal" Style="{StaticResource CampoValor}" Width="104" MinHeight="32" Tag="0,00" ctl:Mascara.Tipo="Moeda"
                                         TextChanged="Sinal_Changed" LostFocus="TxtSinal_LostFocus"/>
                                <ComboBox x:Name="CmbEspecie" Width="150" MinHeight="32" Margin="8,0,0,0" DisplayMemberPath="Descricao" Tag="Espécie"
                                          SelectionChanged="Sinal_Changed" ToolTip="Espécie do sinal"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <TextBlock Text="Total" Style="{StaticResource TextoRotulo}" Margin="0,0,0,4" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtTotal" Text="R$ 0,00" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource CorEnfase}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ErroRodape" Style="{StaticResource TextoErro}" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtSinalPago" Style="{StaticResource TextoAuxiliar}" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <DockPanel Margin="0,16,0,0">
                        <Button x:Name="BtnCancelarAgendamento" DockPanel.Dock="Left" Style="{StaticResource BotaoPerigo}"
                                Content="Cancelar agendamento" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True"
                                Click="BtnCancelarAgendamento_Click"/>
                        <!-- RF29: resumo para o cliente pelo WhatsApp (só depois de salvo) -->
                        <Button x:Name="BtnWhatsapp" DockPanel.Dock="Left" Content="Enviar por WhatsApp" Margin="8,0,0,0" Visibility="Collapsed"
                                ToolTip="Envia o resumo para o cliente, com prévia do texto" Click="BtnWhatsapp_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                            <Button x:Name="BtnSalvarOrcamento" Content="Salvar orçamento" Margin="0,0,8,0" Click="BtnSalvarOrcamento_Click"/>
                            <Button x:Name="BtnAgendar" Content="Agendar" Margin="0,0,8,0" Click="BtnAgendar_Click"/>
                            <Button x:Name="BtnAgendarFaturar" Content="Agendar e faturar" Style="{StaticResource BotaoPrincipal}"
                                    Click="BtnAgendarFaturar_Click"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Fundo escurecido atrás do cadastro rápido de cliente -->
            <Border x:Name="Overlay" Grid.RowSpan="3" Background="{DynamicResource CorOverlay}" CornerRadius="12" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
