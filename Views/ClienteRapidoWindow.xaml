<Window x:Class="EspacoFestas.Views.ClienteRapidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EspacoFestas.Controls"
        Title="Novo cliente" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FonteInter}" FontSize="14" Foreground="{DynamicResource CorTexto}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- Cadastro rápido a partir do agendamento: só o essencial. O cadastro completo (endereço) fica em Clientes. -->
    <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1"
            CornerRadius="12" Padding="24">
        <StackPanel>
            <DockPanel Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeFechar}"
                        ToolTip="Fechar (Esc)" IsCancel="True" Click="BtnCancelar_Click"/>
                <TextBlock Text="Novo cliente" Style="{StaticResource TextoTituloSecao}" FontSize="18" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Nome completo *" Style="{StaticResource TextoRotulo}"/>
            <TextBox x:Name="TxtNome" Tag="Digite o nome" MaxLength="100"/>
            <TextBlock x:Name="ErroNome" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>

            <TextBlock Text="Telefone *" Style="{StaticResource TextoRotulo}" Margin="0,16,0,8"/>
            <TextBox x:Name="TxtTelefone" Tag="(49) 99999-9999" ctl:Mascara.Tipo="Telefone"/>
            <TextBlock x:Name="ErroTelefone" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>

            <TextBlock Text="CPF ou CNPJ" Style="{StaticResource TextoRotulo}" Margin="0,16,0,8"/>
            <TextBox x:Name="TxtCpfCnpj" Tag="000.000.000-00 ou 00.000.000/0000-00" ctl:Mascara.Tipo="CpfCnpj" LostFocus="TxtCpfCnpj_LostFocus"/>
            <TextBlock x:Name="ErroCpfCnpj" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>

            <TextBlock Text="E-mail" Style="{StaticResource TextoRotulo}" Margin="0,16,0,8"/>
            <TextBox x:Name="TxtEmail" Tag="email@exemplo.com" MaxLength="100"/>
            <TextBlock x:Name="ErroEmail" Style="{StaticResource TextoErro}" Margin="0,6,0,0" Visibility="Collapsed"/>

            <TextBlock Text="Endereço e demais dados podem ser completados depois, em Clientes." Style="{StaticResource TextoAuxiliar}"
                       Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <Button Content="Salvar cliente" Style="{StaticResource BotaoPrincipal}" IsDefault="True" Click="BtnSalvar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
