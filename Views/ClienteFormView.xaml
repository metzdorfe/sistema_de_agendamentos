<UserControl x:Class="EspacoFestas.Views.ClienteFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EspacoFestas.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">
            <Button Style="{StaticResource BotaoLink}" ctl:Estilo.Icone="{StaticResource IconeAnterior}" Content="Clientes"
                    HorizontalAlignment="Left" Padding="0" Margin="0,0,0,8" Click="BtnVoltar_Click"/>
            <DockPanel>
                <CheckBox x:Name="ChkAtivo" DockPanel.Dock="Right" Style="{StaticResource Interruptor}" Content="Ativo"
                          IsChecked="True" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel>
                    <TextBlock x:Name="TxtTitulo" Text="Novo Cliente" Style="{StaticResource TextoTituloTela}"/>
                    <TextBlock Text="Preencha os dados do cliente. Campos com * são obrigatórios." Style="{StaticResource TextoSubtitulo}"/>
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="Dados pessoais" Style="{StaticResource TextoTituloSecao}" Margin="0,0,0,20"/>
                        <TextBlock Text="Nome completo *" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtNome" Tag="Digite o nome" MaxLength="100" Margin="0,0,0,16"/>
                        <TextBlock Text="Telefone *" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtTelefone" Tag="(49) 99999-9999" ctl:Mascara.Tipo="Telefone" Margin="0,0,0,16"/>
                        <TextBlock Text="CPF ou CNPJ" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtCpfCnpj" Tag="000.000.000-00 ou 00.000.000/0000-00" ctl:Mascara.Tipo="CpfCnpj" Margin="0,0,0,16"
                                 LostFocus="TxtCpfCnpj_LostFocus"/>
                        <TextBlock Text="E-mail" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtEmail" Tag="email@exemplo.com" MaxLength="100"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Cartao}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="Endereço" Style="{StaticResource TextoTituloSecao}"/>
                            <TextBlock Text=" (opcional)" Style="{StaticResource TextoAuxiliar}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>
                        <TextBlock Text="Rua" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtLogradouro" Tag="Digite a rua" MaxLength="100" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Número" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtNumero" Tag="Nº" MaxLength="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Complemento" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtComplemento" Tag="Apto, sala, etc." MaxLength="60"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Bairro" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtBairro" Tag="Digite o bairro" MaxLength="60" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cidade" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtCidade" Tag="Digite a cidade" MaxLength="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="UF" Style="{StaticResource TextoRotulo}"/>
                                <ComboBox x:Name="CmbUf" MaxDropDownHeight="260"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="CEP" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtCep" Tag="00000-000" ctl:Mascara.Tipo="Cep"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Margin="0,24,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Margin="0,0,8,0" Click="BtnVoltar_Click"/>
                    <Button Content="Salvar Cliente" Style="{StaticResource BotaoPrincipal}" IsDefault="True" Click="BtnSalvar_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtMensagem" Style="{StaticResource TextoErro}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
