<UserControl x:Class="EspacoFestas.Views.ServicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EspacoFestas.Controls"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32">
                <!-- Cabeçalho: ‹ Serviços / Nome. O catálogo em PDF saiu desta tela (ver RelatoriosView). -->
                <DockPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Style="{StaticResource BotaoLink}" ctl:Estilo.Icone="{StaticResource IconeAnterior}" Content="Serviços"
                                    Padding="0" Click="BtnVoltar_Click"/>
                            <TextBlock Text="/" Style="{StaticResource TextoAuxiliar}" FontSize="14" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTrilha" Text="Novo serviço" Style="{StaticResource TextoAuxiliar}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTitulo" Text="Novo serviço" Style="{StaticResource TextoTituloTela}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Dados do serviço -->
                <Border Style="{StaticResource Cartao}" Margin="0,24,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nome *" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtNome" Tag="Ex.: Salão Principal" MaxLength="80"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAtivo" Grid.Column="1" Style="{StaticResource Interruptor}" Content="Ativo"
                                      IsChecked="True" VerticalAlignment="Bottom" Margin="24,0,0,10"/>
                        </Grid>
                        <TextBlock Text="Descrição" Style="{StaticResource TextoRotulo}" Margin="0,16,0,8"/>
                        <TextBox x:Name="TxtDescricao" Style="{StaticResource CampoMultilinha}" MaxLength="255"
                                 Tag="Capacidade, estrutura, o que está incluso... (aparece no catálogo)"/>
                        <DockPanel Margin="0,16,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}" Content="Salvar serviço" Click="BtnSalvarServico_Click"/>
                            <TextBlock x:Name="TxtMensagemServico" Style="{StaticResource TextoErro}" FontSize="13" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AvisoNovo" Style="{StaticResource Cartao}" Margin="0,16,0,0" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <ctl:Icone Dados="{StaticResource IconeInfo}" Foreground="{DynamicResource CorDestaque}" Margin="0,0,10,0"/>
                        <TextBlock Text="Salve o serviço para cadastrar as faixas de preço e os adicionais." Style="{StaticResource TextoAuxiliar}"
                                   FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Faixas de preço -->
                <Border x:Name="CartaoFaixas" Style="{StaticResource Cartao}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" ctl:Estilo.Icone="{StaticResource IconeMais}" Content="Faixa" Click="BtnNovaFaixa_Click"/>
                            <StackPanel>
                                <TextBlock Text="Faixas de preço" Style="{StaticResource TextoTituloSecao}"/>
                                <TextBlock Text="No agendamento, a faixa é escolhida manualmente. Arraste pelo ≡ para mudar a ordem."
                                           Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Edição inline da faixa -->
                        <Border x:Name="EditorFaixa" Visibility="Collapsed" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                Background="{DynamicResource CorPrincipalFundo}">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Nome da faixa" Style="{StaticResource TextoRotulo}"/>
                                    <TextBox x:Name="TxtFaixaNome" Tag="Ex.: Seg a Qua, Fim de semana/Feriado" MaxLength="80"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Valor (R$)" Style="{StaticResource TextoRotulo}"/>
                                    <TextBox x:Name="TxtFaixaValor" Style="{StaticResource CampoValor}" Tag="0,00" ctl:Mascara.Tipo="Moeda"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,4,0" Click="BtnCancelarFaixa_Click"/>
                                    <Button Content="Salvar" Style="{StaticResource BotaoPrincipal}" Click="BtnSalvarFaixa_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TxtMensagemFaixa" Style="{StaticResource TextoErro}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="ListaFaixas" Style="{StaticResource ListaLimpa}" AllowDrop="True" Drop="ListaFaixas_Drop"
                                 DragOver="ListaFaixas_DragOver">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Height="52" x:Name="Linha">
                                        <Border DockPanel.Dock="Left" Background="Transparent" Cursor="SizeNS" Padding="4,0,12,0"
                                                ToolTip="Arraste para reordenar" MouseLeftButtonDown="AlcaFaixa_MouseLeftButtonDown">
                                            <ctl:Icone Dados="{StaticResource IconeArrastar}" Foreground="{DynamicResource CorTextoSecundario}" Width="16" Height="16"/>
                                        </Border>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeEditar}"
                                                ToolTip="Editar faixa" Margin="8,0,0,0" Click="BtnEditarFaixa_Click"/>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Interruptor}" IsChecked="{Binding Ativo, Mode=OneWay}"
                                                  VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Ativa / inativa (faixa usada não é excluída)"
                                                  Click="ChkFaixaAtiva_Click"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValorTexto}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Style="{StaticResource TextoValor}"/>
                                        <TextBlock x:Name="TxtNomeFaixa" Text="{Binding Nome}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ativo}" Value="False">
                                            <Setter TargetName="TxtNomeFaixa" Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VazioFaixas" Text="Nenhuma faixa ainda. O serviço só aparece para agendar com pelo menos uma faixa ativa."
                                   Style="{StaticResource TextoAuxiliar}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Adicionais do serviço -->
                <Border x:Name="CartaoAdicionais" Style="{StaticResource Cartao}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button ctl:Estilo.Icone="{StaticResource IconeMais}" Content="Novo" Margin="0,0,8,0" Click="BtnNovoAdicional_Click"/>
                                <Button x:Name="BtnUsarExistente" ctl:Estilo.Icone="{StaticResource IconeVincular}" Content="Usar existente"
                                        Click="BtnUsarExistente_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Adicionais" Style="{StaticResource TextoTituloSecao}"/>
                                <TextBlock Text="Garçom, buffet, decoração, DJ... só os adicionais daqui aparecem no agendamento deste serviço."
                                           Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ListBox x:Name="ListaAdicionais" Style="{StaticResource ListaLimpa}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel MinHeight="56">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeDesvincular}"
                                                ToolTip="Remover deste serviço (não apaga o adicional)" Margin="4,0,0,0" Click="BtnDesvincular_Click"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeEditar}"
                                                ToolTip="Editar adicional" Margin="8,0,0,0" Click="BtnEditarAdicional_Click"/>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="150">
                                            <TextBlock Text="{Binding VendaTexto}" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource TextoValor}"/>
                                            <TextBlock Text="{Binding CustoTexto}" Style="{StaticResource TextoAuxiliar}" HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nome}" FontWeight="Medium"/>
                                                <Border x:Name="SeloInativo" Style="{StaticResource Selo}" Margin="8,0,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="Inativo"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtOutros" Text="{Binding OutrosServicos}" Style="{StaticResource TextoAuxiliar}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ativo}" Value="False">
                                            <Setter TargetName="SeloInativo" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OutrosServicos}" Value="">
                                            <Setter TargetName="TxtOutros" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VazioAdicionais" Text="Nenhum adicional neste serviço." Style="{StaticResource TextoAuxiliar}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Lista para "Usar existente" -->
        <Popup x:Name="PopupExistentes" PlacementTarget="{Binding ElementName=BtnUsarExistente}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1"
                    CornerRadius="10" Padding="8" Margin="0,4,0,0" Width="340" MaxHeight="340">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Adicionais de outros serviços" Style="{StaticResource TextoRotulo}" Margin="8,4,8,8"/>
                    <TextBlock x:Name="VazioExistentes" DockPanel.Dock="Top" Text="Nenhum outro adicional cadastrado."
                               Style="{StaticResource TextoAuxiliar}" Margin="8,0,8,8"/>
                    <ListBox x:Name="ListaExistentes" Style="{StaticResource ListaLimpa}" PreviewMouseLeftButtonUp="ListaExistentes_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Height="44" Cursor="Hand">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding VendaTexto}" Style="{StaticResource TextoAuxiliar}"
                                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Foreground="{DynamicResource CorTexto}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>

        <!-- Painel lateral de edição do adicional -->
        <Border x:Name="Sombra" Background="{DynamicResource CorFundo}" Opacity="0.6" Visibility="Collapsed"
                MouseLeftButtonDown="Sombra_MouseLeftButtonDown"/>
        <Border x:Name="PainelAdicional" Width="420" HorizontalAlignment="Right" Visibility="Collapsed"
                Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DeslocamentoPainel"/>
            </Border.RenderTransform>
            <DockPanel Margin="24">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeFechar}"
                            ToolTip="Fechar (Esc)" Click="BtnCancelarAdicional_Click"/>
                    <TextBlock x:Name="TxtTituloAdicional" Text="Novo adicional" Style="{StaticResource TextoTituloSecao}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock x:Name="TxtMensagemAdicional" Style="{StaticResource TextoErro}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Margin="0,0,8,0" Click="BtnCancelarAdicional_Click"/>
                        <Button Content="Salvar adicional" Style="{StaticResource BotaoPrincipal}" Click="BtnSalvarAdicional_Click"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="AvisoCompartilhado" Style="{StaticResource Aviso}" Margin="0,0,0,16" Visibility="Collapsed">
                            <DockPanel>
                                <ctl:Icone DockPanel.Dock="Left" Dados="{StaticResource IconeInfo}" Foreground="{DynamicResource CorTextoSecundario}"
                                           Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="TxtAvisoCompartilhado" TextWrapping="Wrap" FontWeight="Normal"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Nome *" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtAdicionalNome" Tag="Ex.: Garçom, Buffet, Decoração" MaxLength="80" Margin="0,0,0,16"/>
                        <TextBlock Text="Descrição" Style="{StaticResource TextoRotulo}"/>
                        <TextBox x:Name="TxtAdicionalDescricao" Style="{StaticResource CampoMultilinha}" MaxLength="255" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Valor de venda (R$) *" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtAdicionalVenda" Style="{StaticResource CampoValor}" Tag="0,00" ctl:Mascara.Tipo="Moeda"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Valor de custo (R$)" Style="{StaticResource TextoRotulo}"/>
                                <TextBox x:Name="TxtAdicionalCusto" Style="{StaticResource CampoValor}" Tag="0,00" ctl:Mascara.Tipo="Moeda"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="O custo é o que a empresa paga (ex.: o garçom); serve para calcular o lucro do evento."
                                   Style="{StaticResource TextoAuxiliar}" Margin="0,0,0,20"/>
                        <CheckBox x:Name="ChkPorQuantidade" Style="{StaticResource Interruptor}" Content="Cobra por quantidade" Margin="0,0,0,4"/>
                        <TextBlock Text="Total = quantidade × valor (ex.: garçom, comida por pessoa)." Style="{StaticResource TextoAuxiliar}"
                                   Margin="52,0,0,16"/>
                        <CheckBox x:Name="ChkAdicionalAtivo" Style="{StaticResource Interruptor}" Content="Ativo" IsChecked="True"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
