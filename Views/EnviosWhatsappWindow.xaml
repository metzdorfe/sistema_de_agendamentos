<Window x:Class="EspacoFestas.Views.EnviosWhatsappWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EspacoFestas.Controls"
        Title="Envios pelo WhatsApp" Width="960" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FonteInter}" FontSize="14" Foreground="{DynamicResource CorTexto}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- RF27: acompanhamento dos envios (últimas 200), filtro por situação, texto da mensagem e reenvio das falhas -->
    <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Background="Transparent"
                    MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <DockPanel Margin="24,20,16,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" ctl:Estilo.Icone="{StaticResource IconeFechar}"
                            VerticalAlignment="Top" ToolTip="Fechar (Esc)" Click="BtnFechar_Click"/>
                    <StackPanel>
                        <TextBlock Text="Envios pelo WhatsApp" Style="{StaticResource TextoTituloSecao}" FontSize="20"/>
                        <TextBlock Text="Acompanhe o que foi enviado e reenvie o que falhou." Style="{StaticResource TextoAuxiliar}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,16,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Resumo do dia e filtro -->
                <DockPanel Margin="0,0,0,12">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SeloDestaque}" Padding="12,6">
                        <TextBlock x:Name="TxtResumo"/>
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource GrupoAbas}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FiltroTodas" Style="{StaticResource Aba}" Content="Todas" IsChecked="True" GroupName="FiltroEnvios" Click="Filtro_Click"/>
                            <RadioButton x:Name="FiltroEnviadas" Style="{StaticResource Aba}" Content="Enviadas" GroupName="FiltroEnvios" Click="Filtro_Click"/>
                            <RadioButton x:Name="FiltroFalhas" Style="{StaticResource Aba}" Content="Com falha" GroupName="FiltroEnvios" Click="Filtro_Click"/>
                        </StackPanel>
                    </Border>
                    <Border/>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Cartao}" Padding="8,4">
                    <Grid>
                        <DataGrid x:Name="Grade" SelectionChanged="Grade_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="140"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="2*" ElementStyle="{StaticResource CelulaNegrito}"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*" ElementStyle="{StaticResource CelulaTexto}"/>
                                <DataGridTemplateColumn Header="Situação" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Selo" Style="{StaticResource Selo}">
                                                <TextBlock Text="{Binding Status}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Enviada">
                                                    <Setter TargetName="Selo" Property="Style" Value="{StaticResource SeloSucesso}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Falha">
                                                    <Setter TargetName="Selo" Property="Style" Value="{StaticResource SeloErro}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Motivo da falha" Binding="{Binding Erro}" Width="2*" ElementStyle="{StaticResource CelulaTexto}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="Vazio" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <ctl:Icone Dados="{StaticResource IconeEnvios}" Foreground="{DynamicResource CorTextoSecundario}" Width="40" Height="40"/>
                            <TextBlock Text="Nenhuma mensagem aqui" Style="{StaticResource TextoTituloSecao}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                            <TextBlock Text="As mensagens aparecem aqui conforme são enviadas." Style="{StaticResource TextoAuxiliar}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Texto da mensagem selecionada -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Mensagem" Style="{StaticResource TextoRotulo}"/>
                    <Border Background="{DynamicResource CorSuperficieElevada}" CornerRadius="8" Padding="12,8" MinHeight="40" MaxHeight="96">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtTexto" TextWrapping="Wrap" Foreground="{DynamicResource CorTextoSecundario}"
                                       Text="Selecione uma mensagem para ver o texto."/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fechar" Style="{StaticResource BotaoFantasma}" Margin="0,0,8,0" Click="BtnFechar_Click"/>
                    <Button x:Name="BtnReenviar" Content="Reenviar" Style="{StaticResource BotaoPrincipal}" ctl:Estilo.Icone="{StaticResource IconeEnvios}"
                            IsEnabled="False" ToolTip="Selecione uma mensagem com falha" ToolTipService.ShowOnDisabled="True" Click="BtnReenviar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
