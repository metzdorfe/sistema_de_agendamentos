<Window x:Class="EspacoFestas.Views.DialogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EspacoFestas.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FonteInter}" FontSize="14" Foreground="{DynamicResource CorTexto}">
    <Border Background="{DynamicResource CorSuperficie}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1"
            CornerRadius="12" Padding="24" Margin="16">
        <!-- Sombra cinza bem suave, só para destacar a janela flutuante -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ctl:Icone x:Name="IconeTitulo" Dados="{StaticResource IconeInfo}" Foreground="{DynamicResource CorDestaque}" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTitulo" Style="{StaticResource TextoTituloSecao}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtMensagem" TextWrapping="Wrap" Foreground="{DynamicResource CorTextoSecundario}" LineHeight="20"/>
            <!-- Resposta em texto (ex.: motivo do cancelamento), só no Dialogo.PedirTexto -->
            <StackPanel x:Name="PainelResposta" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtRotuloResposta" Style="{StaticResource TextoRotulo}"/>
                <TextBox x:Name="TxtResposta" Style="{StaticResource CampoMultilinha}" MaxLength="200" TextChanged="TxtResposta_TextChanged"/>
                <DockPanel Margin="0,6,0,0">
                    <!-- Contador de caracteres (limite = VARCHAR do banco) -->
                    <TextBlock x:Name="TxtContador" DockPanel.Dock="Right" Style="{StaticResource TextoAuxiliar}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock x:Name="TxtErroResposta" Style="{StaticResource TextoErro}" Visibility="Collapsed"/>
                </DockPanel>
            </StackPanel>
            <DockPanel Margin="0,24,0,0">
                <!-- Ação extra à esquerda (ex.: "Mostrar na pasta"), só no Dialogo.ArquivoSalvo -->
                <Button x:Name="BtnExtra" DockPanel.Dock="Left" Style="{StaticResource BotaoLink}" Visibility="Collapsed" Click="BtnExtra_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelar" Content="Cancelar" Margin="0,0,8,0" IsCancel="True" Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnConfirmar" Content="OK" Style="{StaticResource BotaoPrincipal}" IsDefault="True" Click="BtnConfirmar_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
