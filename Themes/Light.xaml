<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema claro (padrão). Mesmas chaves do Dark.xaml, cores diferentes.
         Base neutra (cinzas frios) e o roxo da marca só no que é ação ou destaque: botão principal, item ativo,
         foco e seleção. Profundidade pelo contraste fundo cinza × cartão branco, com borda fina.
         As telas usam sempre {DynamicResource ...}, nunca cor fixa. -->

    <SolidColorBrush x:Key="CorFundo" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="CorSuperficie" Color="#FFFFFF"/>
    <!-- Preenchimento neutro: hover, trilho das abas, campos somente leitura -->
    <SolidColorBrush x:Key="CorSuperficieElevada" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="CorBorda" Color="#E4E4E7"/>
    <!-- Borda mais forte: hover de campos e barra de rolagem -->
    <SolidColorBrush x:Key="CorBotaoSecundario" Color="#CFCFD6"/>
    <SolidColorBrush x:Key="CorBotaoPrincipal" Color="#6D3FC0"/>
    <SolidColorBrush x:Key="CorBotaoPrincipalHover" Color="#5B32A6"/>
    <SolidColorBrush x:Key="CorFoco" Color="#6D3FC0"/>
    <!-- Anel de foco em volta do campo (roxo translúcido) -->
    <SolidColorBrush x:Key="CorFocoAnel" Color="#336D3FC0"/>
    <SolidColorBrush x:Key="CorDestaque" Color="#6D3FC0"/>
    <SolidColorBrush x:Key="CorEnfase" Color="#5B32A6"/>
    <SolidColorBrush x:Key="CorTexto" Color="#1C1B22"/>
    <SolidColorBrush x:Key="CorTextoSecundario" Color="#6B6B76"/>
    <SolidColorBrush x:Key="CorTextoSobrePrincipal" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CorSelecao" Color="#F3EFFB"/>

    <!-- Logo da UnC: no claro, a original colorida (a branca some em fundo claro) -->
    <BitmapImage x:Key="ImagemLogoUnc" UriSource="pack://application:,,,/Assets/Brand/unc_marca.png"/>
    <BitmapImage x:Key="ImagemLogoUncHorizontal" UriSource="pack://application:,,,/Assets/Brand/unc_logo.png"/>
    <!-- Fundo escurecido atrás de janelas modais (popup de agendamento) -->
    <SolidColorBrush x:Key="CorOverlay" Color="#661C1B22"/>

    <!-- Status: só onde carregam significado; contraste ≥ 4,5:1 sobre branco -->
    <SolidColorBrush x:Key="CorOrcamento" Color="#B45309"/>
    <SolidColorBrush x:Key="CorSucesso" Color="#15803D"/>
    <SolidColorBrush x:Key="CorErro" Color="#DC2626"/>
    <SolidColorBrush x:Key="CorOrcamentoFundo" Color="#1FF59E0B"/>
    <SolidColorBrush x:Key="CorSucessoFundo" Color="#1A16A34A"/>
    <SolidColorBrush x:Key="CorErroFundo" Color="#14DC2626"/>
    <SolidColorBrush x:Key="CorPrincipalFundo" Color="#146D3FC0"/>
    <!-- Pílula de orçamento com sinal: âmbar preenchido, texto escuro -->
    <SolidColorBrush x:Key="CorOrcamentoPreenchido" Color="#FCD58A"/>
    <SolidColorBrush x:Key="CorTextoSobreOrcamento" Color="#1C1B22"/>
</ResourceDictionary>
