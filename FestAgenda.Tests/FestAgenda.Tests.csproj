<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes das regras de negócio (xUnit v3). Os de banco criam um Firebird novo a partir de Database\schema.sql
       num servidor local (localhost:3050, SYSDBA/masterkey) e são pulados se ele não estiver no ar. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit.v3" Version="1.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
    <!-- Mesma versão do sistema: o provider do Firebird puxa a 10.0.0 e daria conflito -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EspacoFestas.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Database\schema.sql" Link="Database\schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Database\dados-iniciais.sql" Link="Database\dados-iniciais.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
